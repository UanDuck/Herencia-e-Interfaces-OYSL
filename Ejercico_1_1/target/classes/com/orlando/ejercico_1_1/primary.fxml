<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="20.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.orlando.ejercico_1_1.PrimaryController">
   <children>
      <HBox alignment="CENTER">
         <children>
            <Label text="Fecha de nacimiento:  (dd/mm/aaaa))" />
            <TextField fx:id="txtFecha" promptText="dd/mm/aaaa" />
         </children>
      </HBox>
      <HBox alignment="CENTER" nodeOrientation="LEFT_TO_RIGHT" prefHeight="0.0" prefWidth="265.0">
         <children>
            <Button fx:id="primaryButton" onAction="#calcular" text="Calcular" textAlignment="JUSTIFY" />
            <Button fx:id="BtnLimpiar" mnemonicParsing="false" onAction="#limpiar" text="Limpiar" />
         </children>
      </HBox>
      <Label fx:id="txtRes" />
   </children>
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>
</VBox>
