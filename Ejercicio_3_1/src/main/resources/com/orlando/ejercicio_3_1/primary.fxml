<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="20.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.orlando.ejercicio_3_1.PrimaryController">
   <children>
      <Label text="Contar numero de clics" />
      <TextField fx:id="txtContar" disable="true" />
      <Button fx:id="btnContar" onAction="#contar" text="¡Contar!" />
      <Label text="Esperar 10 segundos" />
      <ProgressBar fx:id="ProgressBar" prefWidth="200.0" progress="0.0" />
      <Button fx:id="btnEsperar" mnemonicParsing="false" onAction="#esperar" text="¡Esperar!" />
   </children>
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>
</VBox>
